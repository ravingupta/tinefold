{
  "name": "@ravingupta/tinefold-engine",
  "version": "0.3.0",
  "description": "Pure TypeScript engine for tinefold, an AI brainstorming tool built on an AND-OR graph: event log, rules, staleness, prompts, providers, documents.",
  "keywords": [
    "brainstorming",
    "and-or-graph",
    "llm",
    "event-sourcing",
    "anthropic",
    "openai",
    "prd",
    "design-doc"
  ],
  "author": "Ravin Gupta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravingupta/tinefold.git",
    "directory": "tinefold-engine"
  },
  "homepage": "https://github.com/ravingupta/tinefold/tree/main/tinefold-engine#readme",
  "bugs": {
    "url": "https://github.com/ravingupta/tinefold/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
